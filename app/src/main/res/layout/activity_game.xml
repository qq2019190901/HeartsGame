<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20">

    <!-- Top player (North / AI) -->
    <LinearLayout
        android:id="@+id/player_top_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="North"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0分"
            android:textColor="#A5D6A7"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/player_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFEB3B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Left player (West / AI) -->
    <LinearLayout
        android:id="@+id/player_left_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="West"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0分"
            android:textColor="#A5D6A7"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/player_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFEB3B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Right player (East / AI) -->
    <LinearLayout
        android:id="@+id/player_right_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="East"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0分"
            android:textColor="#A5D6A7"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/player_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFEB3B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Phase and Score info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/phase_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFEB3B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E8F5E9"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Trick area (center) -->
    <LinearLayout
        android:id="@+id/trick_area"
        android:layout_width="280dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#33000000"
        android:padding="8dp" />

    <!-- Pass cards container -->
    <LinearLayout
        android:id="@+id/pass_cards_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="140dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#CC000000"
        android:padding="12dp">

        <TextView
            android:id="@+id/pass_cards_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择3张牌传递"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Action button -->
    <Button
        android:id="@+id/action_button"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="130dp"
        android:text="出牌"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#C62828"
        android:visibility="gone" />

    <!-- Hand view (bottom) -->
    <com.example.hearts.ui.HandView
        android:id="@+id/hand_view"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="8dp" />

</FrameLayout>
